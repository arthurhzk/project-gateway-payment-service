# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=payment_db

#--------------------------------------------------------------------
# Payment Gateways
#--------------------------------------------------------------------
# Gateway 1 (Bearer token authentication)
GATEWAY1_URL=http://localhost:3001
GATEWAY1_EMAIL=dev@betalent.tech
GATEWAY1_TOKEN=your_gateway1_token_here

# Gateway 2 (Header-based authentication)
GATEWAY2_URL=http://localhost:3002
GATEWAY2_AUTH_TOKEN=your_gateway2_auth_token_here
GATEWAY2_AUTH_SECRET=your_gateway2_auth_secret_here